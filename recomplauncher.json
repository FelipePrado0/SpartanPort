{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "SpartanPort",
  "repo": "FelipePrado0/SpartanPort",
  "game": {
    "kind": "folder",
    "label": "The folder of your own God of War III Remastered (PS4) dump, CUSA01623 or CUSA01715, with eboot.bin, sce_module and sce_sys inside.",
    "check": { "file": "eboot.bin" }
  },
  "start": {
    "program": ["SpartanPort.exe", "spartanport-x86_64.AppImage"],
    "args": ["--play"]
  },
  "prepare": {
    "program": ["SpartanPort.exe", "spartanport-x86_64.AppImage"],
    "args": ["--prepare", "--game", "{game}"],
    "label": "Reading your game's files",
    "timeout": 300
  },
  "config": [
    {
      "id": "launcher",
      "format": "json",
      "file": [
        { "path": "{install}/settings.json", "if": "{install}/SpartanPort.exe" },
        { "path": "{local}/spartanport/settings.json" }
      ],
      "game_path": "game_dir"
    },
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/spartanport.ini", "if": "{install}/SpartanPort.exe" },
        { "path": "{local}/spartanport/spartanport.ini" }
      ]
    }
  ],
  "folders": {
    "saves": [
      { "path": "{install}/user", "if": "{install}/SpartanPort.exe" },
      { "path": "{local}/spartanport/user" }
    ],
    "logs": [
      { "path": "{install}/user", "if": "{install}/SpartanPort.exe" },
      { "path": "{local}/spartanport/user" }
    ]
  },
  "saves": [
    "{install}/user/savedata",
    "{local}/spartanport/user/savedata"
  ],
  "settings": [
    {
      "id": "display_mode", "label": "Window", "in": "main",
      "help": "Windowed keeps the game in a window. Borderless fills the screen and switches apps quickly. Fullscreen gives the game the screen to itself.",
      "choices": [
        { "label": "Windowed", "set": { "display_mode": "windowed" } },
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } }
      ],
      "defaults": { "display_mode": "windowed" }
    },
    {
      "id": "render_resolution", "label": "Resolution", "in": "main",
      "help": "What the game draws at. Higher is sharper and needs a faster graphics card.",
      "choices": [
        { "label": "Native", "set": { "render_resolution": "native" } },
        { "label": "720p", "set": { "render_resolution": "720p" } },
        { "label": "900p", "set": { "render_resolution": "900p" } },
        { "label": "1440p", "set": { "render_resolution": "1440p" } },
        { "label": "4K", "set": { "render_resolution": "4K" } }
      ],
      "defaults": { "render_resolution": "native" }
    },
    {
      "id": "engine_fps", "label": "Engine frame rate", "in": "main",
      "help": "How fast the game itself runs. 60 is the PS4's own; higher is smoother.",
      "choices": [
        { "label": "60 (original)", "set": { "engine_fps": "60" } },
        { "label": "100", "set": { "engine_fps": "100" } },
        { "label": "120", "set": { "engine_fps": "120" } },
        { "label": "144", "set": { "engine_fps": "144" } },
        { "label": "240", "set": { "engine_fps": "240" } }
      ],
      "defaults": { "engine_fps": "120" }
    },
    {
      "id": "fps_limit", "label": "Frame rate limit", "in": "main",
      "help": "The most frames shown per second. Set it to your screen's refresh rate to save power.",
      "choices": [
        { "label": "30", "set": { "fps_limit": "30" } },
        { "label": "60", "set": { "fps_limit": "60" } },
        { "label": "120", "set": { "fps_limit": "120" } },
        { "label": "144", "set": { "fps_limit": "144" } },
        { "label": "240", "set": { "fps_limit": "240" } },
        { "label": "Unlimited", "set": { "fps_limit": "0" } }
      ],
      "defaults": { "fps_limit": "0" }
    },
    {
      "id": "vsync", "label": "V-Sync", "in": "main",
      "help": "Waits for your screen's refresh. Off can tear but answers faster.",
      "choices": [
        { "label": "On", "set": { "vsync": "1" } },
        { "label": "Off", "set": { "vsync": "0" } }
      ],
      "defaults": { "vsync": "1" }
    },
    {
      "id": "upscaler", "label": "Upscaling", "in": "main",
      "help": "Draws fewer pixels and rebuilds the full picture. FSR 4 needs an AMD Radeon RX 6000 or newer, or an Intel Arc. TAA smooths edges without upscaling.",
      "choices": [
        { "label": "Off", "set": { "upscaler": "off" } },
        { "label": "FSR 3.1", "set": { "upscaler": "fsr3" } },
        { "label": "FSR 4", "set": { "upscaler": "fsr4" } },
        { "label": "TAA", "set": { "upscaler": "taa" } }
      ],
      "defaults": { "upscaler": "off" }
    },
    {
      "id": "preset", "label": "Upscaling quality", "in": "main",
      "help": "How much of the resolution is drawn before the upscaler rebuilds it. Only used when Upscaling is on.",
      "choices": [
        { "label": "Native AA", "set": { "preset": "0" } },
        { "label": "Ultra Quality", "set": { "preset": "5" } },
        { "label": "Quality", "set": { "preset": "1" } },
        { "label": "Balanced", "set": { "preset": "2" } },
        { "label": "Performance", "set": { "preset": "3" } },
        { "label": "Ultra Performance", "set": { "preset": "4" } }
      ],
      "defaults": { "preset": "1" }
    },
    {
      "id": "anti_aliasing", "label": "Anti-aliasing", "in": "main",
      "help": "Smooths jagged edges on the finished picture.",
      "choices": [
        { "label": "Off", "set": { "anti_aliasing": "off" } },
        { "label": "FXAA", "set": { "anti_aliasing": "fxaa" } },
        { "label": "SMAA", "set": { "anti_aliasing": "smaa" } }
      ],
      "defaults": { "anti_aliasing": "off" }
    },
    {
      "id": "anisotropy", "label": "Texture filtering", "in": "main",
      "help": "Keeps floors and walls sharp at shallow angles. Costs very little.",
      "choices": [
        { "label": "Game's own", "set": { "anisotropy": "0" } },
        { "label": "4x", "set": { "anisotropy": "4" } },
        { "label": "8x", "set": { "anisotropy": "8" } },
        { "label": "16x", "set": { "anisotropy": "16" } }
      ],
      "defaults": { "anisotropy": "0" }
    },
    {
      "id": "show_fps", "label": "Show FPS", "in": "main",
      "help": "The frame rate in a corner of the game.",
      "choices": [
        { "label": "On", "set": { "show_fps": "1" } },
        { "label": "Off", "set": { "show_fps": "0" } }
      ],
      "defaults": { "show_fps": "1" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves and logs", "help": "Your saves, shader cache and the last log.", "open": "saves" },
    { "id": "cache", "label": "Shader cache", "help": "Shaders the game has built. Clearing it makes the next start compile them again.", "clear": "saves/cache" }
  ]
}
