From: spartanport
Subject: [PATCH] FFX 1.1.4: include missing standard headers for libc++ (MSYS2 CLANG64)

---
diff --git a/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp b/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
index b2439b6..ba9b667 100644
--- a/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
@@ -35,6 +35,9 @@
 
 #include <vulkan/vulkan.h>
 
+#include <cmath>  // spartanport: log2 (libc++ does not include it transitively)
+#include <new>    // spartanport: placement new (libc++ does not include it transitively)
+
 // prototypes for functions in the interface
 FfxVersionNumber       GetSDKVersionVK(FfxInterface* backendInterface);
 FfxErrorCode           GetEffectGpuMemoryUsageVK(FfxInterface* backendInterface, FfxUInt32 effectContextId, FfxEffectMemoryUsage* outVramUsage);
diff --git a/upstream/ffx-1.1.4/sdk/src/components/frameinterpolation/ffx_frameinterpolation.cpp b/upstream/ffx-1.1.4/sdk/src/components/frameinterpolation/ffx_frameinterpolation.cpp
index b8f48c0..afd3c13 100644
--- a/upstream/ffx-1.1.4/sdk/src/components/frameinterpolation/ffx_frameinterpolation.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/components/frameinterpolation/ffx_frameinterpolation.cpp
@@ -24,6 +24,7 @@
 #include <cmath>        // for fabs, abs, sinf, sqrt, etc.
 #include <string>       // for memset
 #include <cfloat>       // for FLT_EPSILON
+#include <cstdlib>      // spartanport: _countof on MinGW/libc++
 #include <FidelityFX/host/ffx_frameinterpolation.h>
 
 #define FFX_CPU
diff --git a/upstream/ffx-1.1.4/sdk/src/components/fsr3upscaler/ffx_fsr3upscaler.cpp b/upstream/ffx-1.1.4/sdk/src/components/fsr3upscaler/ffx_fsr3upscaler.cpp
index 94bf581..a7c223b 100644
--- a/upstream/ffx-1.1.4/sdk/src/components/fsr3upscaler/ffx_fsr3upscaler.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/components/fsr3upscaler/ffx_fsr3upscaler.cpp
@@ -24,6 +24,7 @@
 #include <cmath>        // for fabs, abs, sinf, sqrt, etc.
 #include <string.h>     // for memset
 #include <cfloat>       // for FLT_EPSILON
+#include <cstdlib>      // spartanport: _countof on MinGW/libc++
 #include <FidelityFX/host/ffx_fsr3upscaler.h>
 
 #define FFX_CPU
diff --git a/upstream/ffx-1.1.4/sdk/src/components/opticalflow/ffx_opticalflow.cpp b/upstream/ffx-1.1.4/sdk/src/components/opticalflow/ffx_opticalflow.cpp
index ae94c2d..140c937 100644
--- a/upstream/ffx-1.1.4/sdk/src/components/opticalflow/ffx_opticalflow.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/components/opticalflow/ffx_opticalflow.cpp
@@ -24,6 +24,7 @@
 #include <cmath>        // for fabs, abs, sinf, sqrt, etc.
 #include <string>       // for memset
 #include <cfloat>       // for FLT_EPSILON
+#include <cstdlib>      // spartanport: _countof on MinGW/libc++
 #include "FidelityFX/host/ffx_opticalflow.h"
 
 #ifdef __clang__
diff --git a/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp b/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
index e325a05..74c6016 100644
--- a/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
@@ -22,6 +22,7 @@
 
 #include <FidelityFX/host/ffx_message.h>
 #include <FidelityFX/host/ffx_util.h>
+#include <wchar.h>  // spartanport: swprintf_s on MinGW (libc++ does not pull it in)
 
 #ifdef _WIN32
 #ifndef WIN32_LEAN_AND_MEAN
