#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D final_color;
layout(binding = 1) uniform texture2D hudless_color;
layout(binding = 2, r8) uniform writeonly image2D ui_alpha;
layout(binding = 3, std430) buffer Count { uint changed; };
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(ui_alpha)))) return;
    vec3 delta = abs(texelFetch(final_color, p, 0).rgb - texelFetch(hudless_color, p, 0).rgb);
    bool hud = any(greaterThan(delta, vec3(2.0 / 255.0)));
    imageStore(ui_alpha, p, vec4(hud ? 1.0 : 0.0));
    if (hud) atomicAdd(changed, 1);
}
